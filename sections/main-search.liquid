{%- if search.performed -%}
<script>
(function(){
  var q=new URLSearchParams(location.search).get("q")||"";
  function n(s){return (s||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^a-z0-9]/g,"");}
  var P=[{%- for p in collections.all.products limit: 250 -%}[{{ p.title | json }},{{ p.url | json }}]{% unless forloop.last %},{% endunless %}{%- endfor -%}];
  var ALIAS={"plegable":"/products/iphone-duo","iphone17promax":"/products/iphone-17-pro","17promax":"/products/iphone-17-pro","iphone18promax":"/products/iphone-18-pro","iphone18pro":"/products/iphone-18-pro","18promax":"/products/iphone-18-pro","18pro":"/products/iphone-18-pro","iphoneplegable":"/products/iphone-duo","duo":"/products/iphone-duo","iphone18":"/collections/nuevos-iphone","iphonenuevo":"/collections/nuevos-iphone","accesorios":"/collections/accesorios-para-mac","accesoriosmac":"/collections/accesorios-para-mac"};
  var nq=n(q); if(!nq) return;
  if(ALIAS[nq]){ location.replace(ALIAS[nq]); return; }
  var exact=P.filter(function(p){ return n(p[0])===nq; });
  if(exact.length===1){ location.replace(exact[0][1]); return; }
  if(nq.length>=5){
    var part=P.filter(function(p){ return n(p[0]).indexOf(nq)===0; });
    if(part.length===1){ location.replace(part[0][1]); }
  }
})();
</script>
{%- endif -%}
<div class="search-page page-width section-padding">
  <h1 class="search-page__title">{{ 'general.search.search' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <div class="search-form__input-wrap">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.search' | t }}"
        class="search-form__input"
        aria-label="{{ 'general.search.search' | t }}"
      >
      <button type="submit" class="search-form__btn btn">Buscar</button>
    </div>
    <input type="hidden" name="type" value="product">
  </form>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <p class="search-page__count">
        {{ 'general.search.results_with_count' | t: count: search.results_count, terms: search.terms }}
      </p>
      <ul class="product-grid product-grid--{{ section.settings.columns_desktop }}-col list-unstyled" role="list">
        {%- for result in search.results -%}
          {%- if result.object_type == 'product' -%}
            <li class="product-grid__item">
              {%- render 'product-card', product: result -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="search-page__no-results">
        {{ 'general.search.no_results' | t: terms: search.terms }}
      </p>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Búsqueda",
  "tag": "section",
  "class": "section-main-search",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columnas en escritorio"
    }
  ]
}
{% endschema %}
