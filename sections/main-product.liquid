<section class="pp-section pp-x pp-x-{{ section.id }}">
  <div class="page-width">
 
    {%- comment -%} CABECERA {%- endcomment -%}
    <header class="pp-header">
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="pp-header__vendor">{{ product.vendor }}</p>
      {%- endif -%}
      <h1 class="pp-header__title">{{ product.title }}</h1>
      {%- if product.description != blank -%}
        <div class="pp-header__desc rte">{{ product.description }}</div>
      {%- endif -%}
    </header>
 
    {%- comment -%} CONFIGURADOR INTERACTIVO {%- endcomment -%}
    {%- if product.variants.size > 0 -%}
      {%- assign opt1_name = product.options[0] -%}
      {%- assign opt2_name = product.options[1] -%}
      {%- assign opt1_down = opt1_name | downcase -%}
 
      <div class="ppx" id="ppx-{{ section.id }}">
        <div class="ppx__media">
          {%- if product.featured_image != blank -%}
            <img class="ppx__img" id="ppx-img-{{ section.id }}"
                 src="{{ product.featured_image | image_url: width: 1100 }}"
                 alt="{{ product.title }}" width="1100" height="1100" loading="eager">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'ppx__img' }}
          {%- endif -%}
        </div>
 
        <div class="ppx__panel">
          {%- comment -%} Opcion 1 (color u otra) {%- endcomment -%}
          {%- if opt1_name != blank -%}
            <div class="ppx__group">
              <p class="ppx__label">{{ opt1_name }}{% if opt1_down contains 'color' %} — <span id="ppx-o1name-{{ section.id }}"></span>{% endif %}</p>
              <div class="ppx__opts {% if opt1_down contains 'color' %}ppx__opts--sw{% endif %}" id="ppx-o1-{{ section.id }}"></div>
            </div>
          {%- endif -%}
 
          {%- comment -%} Opcion 2 (capacidad u otra) {%- endcomment -%}
          {%- if opt2_name != blank -%}
            <div class="ppx__group">
              <p class="ppx__label">{{ opt2_name }}</p>
              <div class="ppx__opts" id="ppx-o2-{{ section.id }}"></div>
            </div>
          {%- endif -%}
 
          <div class="ppx__pricebox">
            <p class="ppx__price-label">{{ section.settings.price_label | default: 'Precio desde' }}</p>
            <p class="ppx__price" id="ppx-price-{{ section.id }}"></p>
          </div>
 
          {%- if section.settings.whatsapp_number != blank -%}
            <a class="ppx__cta" id="ppx-cta-{{ section.id }}" href="#" target="_blank" rel="noopener">
              {{ section.settings.cta_label | default: 'Consultar por WhatsApp' }}
            </a>
          {%- else -%}
            <form method="post" action="{{ routes.cart_add_url }}" id="ppx-form-{{ section.id }}" accept-charset="UTF-8">
              <input type="hidden" name="id" id="ppx-vid-{{ section.id }}" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="ppx__cta">{{ section.settings.cta_label | default: 'Agregar al carrito' }}</button>
            </form>
          {%- endif -%}
        </div>
      </div>
 
      <script>
      (function(){
        var SID = "{{ section.id }}";
        var O1NAME = {{ opt1_name | default: '' | json }};
        var O2NAME = {{ opt2_name | default: '' | json }};
        var O1COLOR = O1NAME.toLowerCase().indexOf("color") !== -1;
        var FEATURED = {{ product.featured_image | image_url: width: 1100 | json }};
        var WA = {{ section.settings.whatsapp_number | default: '' | json }};
        var TITLE = {{ product.title | json }};
        var VARIANTS = [
          {%- for v in product.variants -%}
          {id:{{ v.id }}, o1:{{ v.option1 | json }}, o2:{{ v.option2 | json }}, avail:{{ v.available }}, price:{{ v.price }}, priceStr:{{ v.price | money | json }}, img:{{ v.image | image_url: width: 1100 | json }}},
          {%- endfor -%}
        ];
        var HEX = {"naranja cósmico":"#D0743F","naranja":"#E8730C","azul profundo":"#2C3E52","azul":"#2E5AAC","plata":"#D9DBDD","gris espacial":"#4B4E52","negro":"#1D1D1F","medianoche":"#2E3641","blanco estelar":"#EDE9E3","blanco":"#F2F2F5","oro":"#F4E2C0","titanio natural":"#C9C3BA","titanio azul":"#3E4C63","titanio blanco":"#E3E1DC","titanio negro":"#39373B","verde":"#3C6E47","rosa":"#F2C9D3","rosado":"#F2C9D3","morado":"#B7A6D8","amarillo":"#F2D24E","rojo":"#C0362C","coral":"#E8734F","cielo":"#AFC7E0","lavanda":"#C6B6E2"};
 
        var o1vals=[], o2vals=[], imgByO1={};
        VARIANTS.forEach(function(v){
          if(v.o1 && o1vals.indexOf(v.o1)===-1) o1vals.push(v.o1);
          if(v.o2 && o2vals.indexOf(v.o2)===-1) o2vals.push(v.o2);
          if(v.o1 && !imgByO1[v.o1] && v.img) imgByO1[v.o1]=v.img;
        });
 
        var cur1 = VARIANTS[0].o1, cur2 = VARIANTS[0].o2;
        var $=function(id){return document.getElementById(id);};
        var img=$("ppx-img-"+SID), price=$("ppx-price-"+SID);
        var o1box=$("ppx-o1-"+SID), o2box=$("ppx-o2-"+SID);
 
        function findVar(){
          for(var i=0;i<VARIANTS.length;i++){
            var v=VARIANTS[i];
            if(v.o1===cur1 && (O2NAME==="" ? true : v.o2===cur2)) return v;
          }
          return VARIANTS[0];
        }
        function render(){
          var v=findVar();
          var src = imgByO1[cur1] || v.img || FEATURED;
          if(img && src){ img.src=src; }
          if(price){ price.textContent = v.price>0 ? v.priceStr : "Consultar"; }
          var o1n=$("ppx-o1name-"+SID); if(o1n) o1n.textContent=cur1;
          if(o1box) [].forEach.call(o1box.children,function(b){ b.classList.toggle("is-sel", b.getAttribute("data-v")===cur1); });
          if(o2box) [].forEach.call(o2box.children,function(b){ b.classList.toggle("is-sel", b.getAttribute("data-v")===cur2); });
          var vid=$("ppx-vid-"+SID); if(vid) vid.value=v.id;
          var cta=$("ppx-cta-"+SID);
          if(cta && WA){
            var digits=WA.replace(/[^0-9]/g,"");
            var msg="Hola, me interesa el "+TITLE+" — "+cur1+(cur2?(" / "+cur2):"")+".";
            cta.href="https://wa.me/"+digits+"?text="+encodeURIComponent(msg);
          }
        }
        function makeSwatch(val){
          var b=document.createElement("button"); b.type="button"; b.className="ppx-sw"; b.setAttribute("data-v",val); b.setAttribute("aria-label",val);
          var hex=HEX[val.toLowerCase()];
          if(hex){ b.style.background=hex; } else if(imgByO1[val]){ b.style.backgroundImage="url("+imgByO1[val]+")"; b.style.backgroundSize="cover"; }
          b.onclick=function(){ cur1=val; render(); };
          return b;
        }
        function makePill(val,dim){
          var b=document.createElement("button"); b.type="button"; b.className="ppx-pill"; b.setAttribute("data-v",val); b.textContent=val;
          b.onclick=function(){ if(dim===1){cur1=val;} else {cur2=val;} render(); };
          return b;
        }
        if(o1box){ o1vals.forEach(function(val){ o1box.appendChild(O1COLOR ? makeSwatch(val) : makePill(val,1)); }); }
        if(o2box){ o2vals.forEach(function(val){ o2box.appendChild(makePill(val,2)); }); }
        render();
      })();
      </script>
    {%- endif -%}
 
    {%- comment -%} BLOQUES PERSONALIZADOS (imagen + descripción) {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="pp-features">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'feature' -%}
              <div class="pp-feature{% if block.settings.reverse %} pp-feature--reverse{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <div class="pp-feature__media">
                    {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(max-width: 749px) 100vw, 50vw', class: 'pp-feature__img', alt: block.settings.image.alt | default: block.settings.heading }}
                  </div>
                {%- endif -%}
                <div class="pp-feature__body">
                  {%- if block.settings.heading != blank -%}<h2 class="pp-feature__heading">{{ block.settings.heading }}</h2>{%- endif -%}
                  {%- if block.settings.text != blank -%}<div class="pp-feature__text rte">{{ block.settings.text }}</div>{%- endif -%}
                </div>
              </div>
            {%- when 'image_full' -%}
              <div class="pp-feature pp-feature--full" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '100vw', class: 'pp-feature__img-full', alt: block.settings.image.alt | default: '' }}
                {%- endif -%}
                {%- if block.settings.caption != blank -%}<p class="pp-feature__caption">{{ block.settings.caption }}</p>{%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
 
  </div>
</section>
 
<style>
.ppx{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;margin:32px 0 8px;}
.ppx__media{background:#f5f5f7;border-radius:24px;padding:24px;display:flex;align-items:center;justify-content:center;aspect-ratio:1/1;}
.ppx__img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;mix-blend-mode:multiply;transition:opacity .2s;}
.ppx__panel{max-width:420px;}
.ppx__group{margin:0 0 24px;}
.ppx__label{font-size:15px;font-weight:600;color:#1d1d1f;margin:0 0 12px;}
.ppx__opts{display:flex;flex-wrap:wrap;gap:10px;}
.ppx-sw{width:34px;height:34px;border-radius:50%;border:1px solid rgba(0,0,0,.12);cursor:pointer;padding:0;background-position:center;outline-offset:3px;}
.ppx-sw.is-sel{outline:2px solid #0071e3;}
.ppx-pill{min-width:64px;padding:12px 18px;border:1px solid #d2d2d7;border-radius:12px;background:#fff;cursor:pointer;font-size:15px;font-weight:500;color:#1d1d1f;transition:border-color .15s;}
.ppx-pill:hover{border-color:#86868b;}
.ppx-pill.is-sel{border-color:#0071e3;box-shadow:0 0 0 1px #0071e3;}
.ppx__pricebox{margin:8px 0 20px;}
.ppx__price-label{font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:#6e6e73;margin:0 0 2px;}
.ppx__price{font-size:28px;font-weight:600;color:#1d1d1f;margin:0;}
.ppx__cta{display:inline-block;width:100%;box-sizing:border-box;text-align:center;background:#0071e3;color:#fff;border:none;border-radius:980px;padding:14px 22px;font-size:16px;font-weight:500;cursor:pointer;text-decoration:none;transition:background .15s;}
.ppx__cta:hover{background:#0077ed;}
@media (max-width:749px){.ppx{grid-template-columns:1fr;gap:24px;}.ppx__panel{max-width:none;}}
</style>
 
{% schema %}
{
  "name": "Producto principal",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "default": true, "label": "Mostrar marca" },
    { "type": "text", "id": "variants_title", "label": "Título de la sección de versiones", "default": "Nuestras versiones" },
    { "type": "text", "id": "price_label", "label": "Etiqueta de precio", "default": "Precio desde" },
    { "type": "text", "id": "storage_options", "label": "Opciones de almacenamiento (no usado en el configurador)", "info": "Separar con |." },
    { "type": "text", "id": "cta_label", "label": "Texto del botón" },
    { "type": "text", "id": "whatsapp_number", "label": "Número de WhatsApp (opcional)", "info": "Si lo llenas, el botón abre WhatsApp con el modelo elegido. Ej: 51987654321. Vacío = Agregar al carrito." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Imagen + descripción",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "heading", "label": "Título" },
        { "type": "richtext", "id": "text", "label": "Descripción" },
        { "type": "checkbox", "id": "reverse", "label": "Invertir orden (texto a la izquierda)", "default": false }
      ]
    },
    {
      "type": "image_full",
      "name": "Imagen completa",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "caption", "label": "Pie de imagen (opcional)" }
      ]
    }
  ],
  "presets": [ { "name": "Producto principal" } ]
}
{% endschema %}
 

