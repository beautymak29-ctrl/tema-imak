<section class="pp-section pp-x pp-x-{{ section.id }}">
  <div class="page-width">

    {%- comment -%} CABECERA {%- endcomment -%}
    <header class="pp-header">
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="pp-header__vendor">{{ product.vendor }}</p>
      {%- endif -%}
      <h1 class="pp-header__title">{{ product.title }}</h1>
      {%- if product.description != blank -%}
        <div class="pp-header__desc rte">{{ product.description }}</div>
      {%- endif -%}
    </header>

    {%- comment -%} CONFIGURADOR GUIADO {%- endcomment -%}
    {%- if product.variants.size > 0 -%}
      <div id="configurador" class="pint__anchor"></div>
      <div class="ppx" id="ppx-{{ section.id }}">
        <div class="ppx__media">
          <div class="ppx__track" id="ppx-track-{{ section.id }}" tabindex="0" aria-label="Fotos del producto">
            <div class="ppx__slide">
              {%- if product.featured_image != blank -%}
                <img class="ppx__img" src="{{ product.featured_image | image_url: width: 1600 }}" alt="{{ product.title }}" width="1600" height="1600" loading="eager">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'ppx__img' }}
              {%- endif -%}
            </div>
          </div>
          <div class="ppx__nav" id="ppx-nav-{{ section.id }}" hidden>
            <button type="button" class="ppx__arrow" id="ppx-prev-{{ section.id }}" aria-label="Foto anterior">&#8249;</button>
            <div class="ppx__dots" id="ppx-dots-{{ section.id }}"></div>
            <button type="button" class="ppx__arrow" id="ppx-next-{{ section.id }}" aria-label="Foto siguiente">&#8250;</button>
          </div>
        </div>

        <div class="ppx__panel">
          <div class="ppx-hello"><h2 class="ppx-hello__t">Arma tu {{ product.title }} a tu medida</h2><p class="ppx-hello__s">Elige paso a paso. Lo que escojas se actualiza al instante y no hay compromiso.</p></div>
          <ol class="ppx-steps" id="ppx-steps-{{ section.id }}" aria-label="Progreso de tu configuración"></ol>
          <div id="ppx-cards-{{ section.id }}"></div>
          <div class="ppx-sum" id="ppx-sum-{{ section.id }}"></div>

          <div class="ppx-pricing" id="ppx-pricing-{{ section.id }}">
            <p class="ppx-pricing__h">Tu precio</p>
            <div class="ppx-pricing__rows" id="ppx-rows-{{ section.id }}"></div>
            <div class="ppx-pricing__tot"><span>Total</span><span class="ppx__price" id="ppx-price-{{ section.id }}"></span></div>
          </div>
          {%- if section.settings.whatsapp_number != blank -%}
            <a class="ppx__cta" id="ppx-cta-{{ section.id }}" href="#" target="_blank" rel="noopener">{{ section.settings.cta_label | default: 'Consultar por WhatsApp' }}</a>
          {%- else -%}
            <form method="post" action="{{ routes.cart_add_url }}" id="ppx-form-{{ section.id }}" accept-charset="UTF-8">
              <input type="hidden" name="id" id="ppx-vid-{{ section.id }}" value="{{ product.selected_or_first_available_variant.id }}">
              <input type="hidden" name="properties[Grabado]" id="ppx-eng-t-{{ section.id }}" value="" disabled>
              <input type="hidden" name="properties[Plazo del grabado]" id="ppx-eng-p-{{ section.id }}" value="Alrededor de 30 días hábiles" disabled>
              <button type="submit" class="ppx__cta">{{ section.settings.cta_label | default: 'Agregar al carrito' }}</button>
              <p class="ppx-eng__foot" id="ppx-eng-note-{{ section.id }}" hidden>Con grabado personalizado, tu pedido puede demorar alrededor de 30 días hábiles.</p>
            </form>
          {%- endif -%}
        </div>
      </div>

      <div class="ppx-bar" id="ppx-bar-{{ section.id }}" hidden>
        <div class="ppx-bar__in">
          <div class="ppx-bar__t"><strong>{{ product.title }}</strong><span id="ppx-bar-sel-{{ section.id }}"></span></div>
          <div class="ppx-bar__r"><span class="ppx-bar__p" id="ppx-bar-price-{{ section.id }}"></span>
            <button type="button" class="ppx-bar__b" id="ppx-bar-btn-{{ section.id }}">{{ section.settings.cta_label | default: 'Agregar al carrito' }}</button></div>
        </div>
      </div>

      <script>
      (function(){
        var SID = "{{ section.id }}";
        var NAMES = {{ product.options | json }};
        var WA = {{ section.settings.whatsapp_number | default: '' | json }};
        var TITLE = {{ product.title | json }};
        var FEATURED = {% if product.featured_image %}{{ product.featured_image | image_url: width: 1600 | json }}{% else %}""{% endif %};
        var ALL = [{%- for im in product.images -%}{{ im | image_url: width: 1600 | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}];
        var V = [
          {%- for v in product.variants -%}
          {id:{{ v.id }}, o:[{{ v.option1 | json }}, {{ v.option2 | json }}, {{ v.option3 | json }}], price:{{ v.price }}, priceStr:{{ v.price | money | json }}, img:{% if v.image %}{{ v.image | image_url: width: 1600 | json }}{% else %}""{% endif %}},
          {%- endfor -%}
        ];
        var HEX = {"naranja cósmico":"#D0743F","naranja":"#E8730C","azul profundo":"#2C3E52","azul":"#2E5AAC","plata":"#D9DBDD","gris espacial":"#4B4E52","negro":"#1D1D1F","negro espacial":"#2A2A2C","medianoche":"#2E3641","blanco estelar":"#EDE9E3","blanco":"#F2F2F5","blanco nube":"#EDEBE6","oro":"#E8CE93","oro claro":"#E7D9B8","oro rosa":"#E7C3B0","titanio natural":"#C9C3BA","natural titanium":"#C9C3BA","natural":"#C9C3BA","titanio azul":"#3E4C63","titanio blanco":"#E3E1DC","titanio negro":"#39373B","black titanium":"#39373B","verde":"#3C6E47","verde azulado":"#3E8E8A","verde bosque":"#3D5A45","verde gris":"#8C978A","rosa":"#F2C9D3","rosa suave":"#F1D5DA","rosa claro":"#F3DCDD","rosado":"#F2C9D3","morado":"#8E7CC3","morado niebla":"#B6A9C9","amarillo":"#F2D24E","amarillo neón":"#E7F04A","rojo":"#C0362C","coral":"#E8734F","cielo":"#AFC7E0","azul cielo":"#AEC6DE","sky blue":"#AEC6DE","azul niebla":"#AFC7E0","azul neblina":"#AFC7E0","azul ancla":"#3A4A63","lavanda":"#C6B6E2","salvia":"#B7C4A8","ultramarino":"#4653C7","ultramar":"#4653C7","gris piedra":"#8A8B86","gris oscuro":"#4A4B4D","clementina":"#E8732C","guayaba":"#EA6A78","melón":"#F0A868","cúrcuma":"#D9A03A","pizarra":"#5B5E63","midnight":"#2E3641","burdeos":"#48282F","glaciar":"#A7B3C6","noche estrellada":"#313A45","índigo":"#3F4A8C","cítrico":"#E4CF3E"};
        var HEXP_ALL = {"iphone-17-pro-max": {"azul profundo": "#3B404F", "naranja cósmico": "#F68442", "plata": "#EEEEEC"}, "iphone-17-pro": {"naranja cósmico": "#F68442", "azul profundo": "#3C4252", "plata": "#EEEDEC"}, "iphone-17": {"negro": "#595A5A", "plata": "#F2F1F0", "salvia": "#B4BF96", "lavanda": "#E7DBEB", "azul neblina": "#A7B8CD"}, "iphone-16": {"ultramarino": "#8BA1EC", "salvia": "#A5CDCD", "negro": "#414141", "lavanda": "#F0A8D5", "plata": "#FDFDFD"}, "iphone-air": {"blanco nube": "#F1F2F2", "oro claro": "#EFECE4", "azul cielo": "#E1E9EF", "negro espacial": "#323231"}, "iphone-16-plus": {"negro": "#404142", "blanco": "#F5F5F3", "rosa": "#EDA3D3", "verde azulado": "#A3CBCA", "ultramar": "#8A9DE7"}, "iphone-16e": {"negro": "#3D3D3E", "blanco": "#F4F4F3"}, "iphone-18-pro-max": {"negro": "#1D1C1E", "burdeos": "#482930", "glaciar": "#A2B1C4", "plata": "#D8D8D7"}, "iphone-18-pro": {"negro": "#1D1D1F", "burdeos": "#47282F", "glaciar": "#A7B3C6", "plata": "#D8D8D8"}, "iphone-duo": {"noche estrellada": "#313A45", "blanco estelar": "#EAE9E7"}, "iphone-15": {"negro": "#3B3C3E", "azul": "#D3DEE4", "verde": "#CCD6C4", "amarillo": "#F3E8C2", "rosa": "#F3D5D6"}};
        var HEXP = HEXP_ALL[{{ product.handle | json }}] || {};
        var N = NAMES.length;
        function kind(i){ var n=NAMES[i]||""; if(/color/i.test(n)) return "color"; if(/pantalla|tama|size|screen/i.test(n)) return "size"; return "cfg"; }
        var RANK={size:0,color:1,cfg:2};
        var ORDER=[]; for(var i=0;i<N;i++) ORDER.push(i);
        ORDER.sort(function(a,b){ return (RANK[kind(a)]-RANK[kind(b)]) || (a-b); });
        var ASK={size:"¿Qué tamaño prefieres?",color:"¿Qué color te gusta más?",cfg:"¿Qué potencia necesitas?"};
        var WHO={"M5":"Ideal para el día a día, estudiar y trabajar.","M5 Pro":"Para crear, programar y editar video con fluidez.","M5 Max":"Para edición profesional, 3D e inteligencia artificial."};
        function $(id){ return document.getElementById(id+"-"+SID); }
        function base(u){ return (u||"").split("?")[0]; }
        function money(c){ return "S/ "+Number(c/100).toLocaleString("es-PE",{maximumFractionDigits:0}); }
        var cur=[V[0].o[0],V[0].o[1],V[0].o[2]], done=[false,false,false], active=0; // posicion dentro de ORDER
        var HANDLE={{ product.handle | json }};
        var ENG=["airpods-pro-3","airpods-4","airpods-max-2","ipad-pro","ipad-air","ipad","ipad-mini"].indexOf(HANDLE)>-1;
        var eng={on:false,txt:""}, engDone=false;
        function allowed(idx,sel){
          var out=[]; V.forEach(function(v){
            for(var p=0;p<ORDER.length;p++){ var j=ORDER[p]; if(j===idx) break; if(v.o[j]!==sel[j]) return; }
            if(v.o[idx]!==null && out.indexOf(v.o[idx])===-1) out.push(v.o[idx]);
          }); return out;
        }
        function normalize(sel){
          ORDER.forEach(function(idx){ var a=allowed(idx,sel); if(a.length && a.indexOf(sel[idx])===-1) sel[idx]=a[0]; }); return sel;
        }
        function find(sel){
          for(var i=0;i<V.length;i++){ var v=V[i], ok=true; for(var j=0;j<N;j++){ if(v.o[j]!==sel[j]) ok=false; } if(ok) return v; } return V[0];
        }
        function priceIf(idx,val){ var sel=cur.slice(); sel[idx]=val; normalize(sel); return find(sel); }
        cur=normalize(cur);

        /* ---------- carrusel ---------- */
        var track=$("ppx-track"), slides=[], sIdx=0;
        function buildTrack(){ if(!track) return; track.innerHTML=slides.map(function(u,i){ return '<div class="ppx__slide"><img class="ppx__img" src="'+u+'" alt="'+TITLE.replace(/"/g,"&quot;")+'" '+(i===0?'loading="eager"':'loading="lazy"')+' draggable="false"></div>'; }).join(""); track.scrollLeft=0; }
        function showSlide(smooth){ if(track){ track.scrollTo({left:sIdx*track.clientWidth,behavior:smooth===false?"auto":"smooth"}); } var d=$("ppx-dots"); if(d) [].forEach.call(d.children,function(x,i){ x.classList.toggle("is-sel",i===sIdx); }); }
        function buildDots(){ var nav=$("ppx-nav"), d=$("ppx-dots"); if(!nav||!d) return; d.innerHTML=""; if(slides.length<2){ nav.hidden=true; return; } nav.hidden=false;
          slides.forEach(function(u,i){ var b=document.createElement("button"); b.type="button"; b.className="ppx__dot"+(i===sIdx?" is-sel":""); b.setAttribute("aria-label","Foto "+(i+1)); b.onclick=function(){ sIdx=i; showSlide(); }; d.appendChild(b); }); }
        function step(d){ if(slides.length<2) return; sIdx=(sIdx+d+slides.length)%slides.length; showSlide(); }
        (function(){ var p=$("ppx-prev"), n=$("ppx-next"); if(p) p.onclick=function(){ step(-1); }; if(n) n.onclick=function(){ step(1); };
          if(!track) return; var t; track.addEventListener("scroll",function(){ clearTimeout(t); t=setTimeout(function(){ var i=Math.round(track.scrollLeft/Math.max(1,track.clientWidth)); if(i!==sIdx){ sIdx=i; var d=$("ppx-dots"); if(d) [].forEach.call(d.children,function(x,k){ x.classList.toggle("is-sel",k===sIdx); }); } },80); },{passive:true});
          track.addEventListener("keydown",function(e){ if(e.key==="ArrowRight"){ e.preventDefault(); step(1); } else if(e.key==="ArrowLeft"){ e.preventDefault(); step(-1); } }); })();
        var firstImg=true;
        function updateImage(v){
          var src=v.img||FEATURED;
          if(firstImg){ firstImg=false; slides=ALL.slice(); if(!slides.length&&src) slides=[src]; sIdx=0; buildTrack(); buildDots(); showSlide(false); return; }
          var bs=slides.map(base), k=bs.indexOf(base(src));
          if(k<0&&src){ slides.unshift(src); k=0; buildTrack(); buildDots(); }
          sIdx=Math.max(0,k); showSlide(true);
        }

        /* ---------- pasos ---------- */
        var cards=$("ppx-cards"), stepsEl=$("ppx-steps");
        function cfgParse(s){
          var parts=(s||"").split(" · "), chip=parts[0]||"", m=chip.match(/^(M\d(?: Pro| Max| Ultra)?)/), cores=chip.match(/(\d+)C\/(\d+)G/);
          return {chip:m?m[1]:chip, cpu:cores?cores[1]:"", gpu:cores?cores[2]:"", mem:parts[1]||"", ssd:parts[2]||""};
        }
        function stepTitle(idx,isDone){ var k=kind(idx); return isDone ? ('<small>'+NAMES[idx]+'</small>') : ('<b>'+(ASK[k]||("Elige tu "+NAMES[idx].toLowerCase()))+'</b>'); }
        function optionsHTML(idx){
          var k=kind(idx), vals=allowed(idx,cur), el=document.createElement("div");
          if(k==="color"){
            el.className="ppx-colors";
            vals.forEach(function(val){ var b=document.createElement("button"); b.type="button"; b.className="ppx-sw"+(val===cur[idx]?" is-sel":""); b.setAttribute("aria-label",val); b.title=val; b.style.background=HEXP[val.toLowerCase()]||HEX[val.toLowerCase()]||"#C7C7CC"; b.onclick=function(){ cur[idx]=val; normalize(cur); update(true); }; el.appendChild(b); });
            var nm=document.createElement("p"); nm.className="ppx-colors__n"; nm.textContent=cur[idx]; el.appendChild(nm);
            var go=document.createElement("button"); go.type="button"; go.className="ppx-go"; go.textContent="Continuar"; go.onclick=function(){ pick(idx,cur[idx]); }; el.appendChild(go);
          } else if(k==="size"){
            el.className="ppx-list";
            vals.forEach(function(val){
              var chips=[]; V.forEach(function(v){ if(v.o[idx]===val&&v.o[2]&&/^M\d/.test(v.o[2])){ var c=cfgParse(v.o[2]).chip; if(chips.indexOf(c)===-1) chips.push(c); } });
              var minV=null; V.forEach(function(v){ if(v.o[idx]===val&&(minV===null||v.price<minV)) minV=v.price; });
              var b=document.createElement("button"); b.type="button"; b.className="ppx-size"+(val===cur[idx]?" is-sel":"");
              b.innerHTML='<span class="ppx-size__t"></span><span class="ppx-size__s"></span>';
              b.children[0].textContent=val;
              b.children[1].textContent=chips.length?("Disponible con chip "+chips.join(", ").replace(/, ([^,]*)$/," o $1")+"."):(/Pro Max/.test(val)?"Pantalla de 6,9 pulgadas.":(/iPhone \d+ Pro/.test(val)?"Pantalla de 6,3 pulgadas.":""));
              b.onclick=function(){ pick(idx,val); }; el.appendChild(b);
            });
          } else {
            el.className="ppx-list";
            var min=null; vals.forEach(function(val){ var v=priceIf(idx,val); if(min===null||v.price<min) min=v.price; });
            vals.forEach(function(val){
              var v=priceIf(idx,val), p=cfgParse(val), b=document.createElement("button"); b.type="button"; b.className="ppx-cfg"+(val===cur[idx]?" is-sel":"");
              b.innerHTML='<span class="ppx-cfg__l"><span class="ppx-cfg__chip"></span><span class="ppx-cfg__spec"></span></span><span class="ppx-cfg__r"><span class="ppx-cfg__who"></span></span>';
              var parts=val.split(" · ");
              b.querySelector(".ppx-cfg__chip").textContent=parts[0]+(/^M\d/.test(parts[0])?" chip":"");
              b.querySelector(".ppx-cfg__spec").textContent=(parts[1]?(/GB/.test(parts[1])?parts[1]+" de memoria":parts[1]):"")+(parts[2]?" · "+parts[2]+" de SSD":"");
              var who=(function(){ var m=parts[0].match(/^(M\d(?: Pro| Max| Ultra)?)/); return m?(WHO[m[1]]||""):""; })();
              b.querySelector(".ppx-cfg__who").textContent=who;
              b.onclick=function(){ pick(idx,val); }; el.appendChild(b);
            });
          }
          return el;
        }
        function renderSteps(){
          if(!cards) return; cards.innerHTML=""; if(stepsEl) stepsEl.innerHTML="";
          ORDER.forEach(function(idx,p){
            var isA=(p===active), isD=done[idx]&&!isA;
            var c=document.createElement("section"); c.className="ppx-card"+(isA?" is-active":"")+(isD?" is-done":"");
            var h=document.createElement("button"); h.type="button"; h.className="ppx-card__h";
            h.innerHTML=(isD?'<span class="ppx-card__n">&#10003;</span>':'')+'<span class="ppx-card__t">'+stepTitle(idx,isD)+'</span>'+(isD?'<span class="ppx-card__v"></span><span class="ppx-card__c">Cambiar</span>':'');
            if(isD) h.querySelector(".ppx-card__v").textContent=cur[idx];
            h.onclick=function(){ active=(active===p?-1:p); renderSteps(); };
            c.appendChild(h);
            if(isA){ var b=document.createElement("div"); b.className="ppx-card__b"; b.appendChild(optionsHTML(idx)); c.appendChild(b); }
            cards.appendChild(c);
            if(stepsEl){ var li=document.createElement("li"); li.className=(done[idx]?"is-done ":"")+(isA?"is-active":""); li.textContent=NAMES[idx]; li.onclick=function(){ active=p; renderSteps(); }; stepsEl.appendChild(li); }
          });
          if(ENG){
            var pe=ORDER.length, aE=(active===pe), dE=engDone&&!aE;
            var ce=document.createElement("section"); ce.className="ppx-card"+(aE?" is-active":"")+(dE?" is-done":"");
            var he=document.createElement("button"); he.type="button"; he.className="ppx-card__h";
            he.innerHTML=(dE?'<span class="ppx-card__n">&#10003;</span>':'')+'<span class="ppx-card__t">'+(dE?'<small>Personalización</small>':'<b>¿Quieres personalizarlo?</b>')+'</span>'+(dE?'<span class="ppx-card__v"></span><span class="ppx-card__c">Cambiar</span>':'');
            if(dE) he.querySelector(".ppx-card__v").textContent=eng.on?('Grabado'+(eng.txt?(': '+eng.txt):'')):'Sin grabado';
            he.onclick=function(){ active=(active===pe?-1:pe); renderSteps(); };
            ce.appendChild(he);
            if(aE){
              var be=document.createElement("div"); be.className="ppx-card__b"; var lst=document.createElement("div"); lst.className="ppx-list";
              [["Sin grabado","Lo recibes en el tiempo habitual de entrega.",false],["Añadir grabado","Gratis. Combina emojis, nombres, iniciales y números.",true]].forEach(function(o){
                var b=document.createElement("button"); b.type="button"; b.className="ppx-size"+(eng.on===o[2]?" is-sel":"");
                b.innerHTML='<span class="ppx-size__t"></span><span class="ppx-size__s"></span>'; b.children[0].textContent=o[0]; b.children[1].textContent=o[1];
                b.onclick=function(){ eng.on=o[2]; if(!o[2]){ eng.txt=""; engDone=true; active=-1; } renderSteps(); update(false); };
                lst.appendChild(b);
              });
              be.appendChild(lst);
              if(eng.on){
                var box=document.createElement("div"); box.className="ppx-eng";
                box.innerHTML='<label class="ppx-eng__l">Texto del grabado</label><input type="text" class="ppx-eng__i" maxlength="30" placeholder="Ej: Ana ♥ 2026" autocomplete="off"><p class="ppx-eng__n"><strong>Tiempo de entrega:</strong> el grabado personalizado puede demorar alrededor de <strong>30 días hábiles</strong>. Si lo prefieres más rápido, elige «Sin grabado».</p><button type="button" class="ppx-eng__ok">Listo</button>';
                var inp=box.querySelector("input"); inp.value=eng.txt; inp.oninput=function(){ eng.txt=inp.value; var t=$("ppx-eng-t"); if(t) t.value=eng.txt; update(false,true); };
                box.querySelector(".ppx-eng__ok").onclick=function(){ engDone=true; active=-1; renderSteps(); update(false); };
                be.appendChild(box);
              }
              ce.appendChild(be);
            }
            cards.appendChild(ce);
            if(stepsEl){ var le=document.createElement("li"); le.className=(engDone?"is-done ":"")+(aE?"is-active":""); le.textContent="Grabado"; le.onclick=function(){ active=pe; renderSteps(); }; stepsEl.appendChild(le); }
          }
        }
        function pick(idx,val){
          cur[idx]=val; normalize(cur); done[idx]=true;
          var p=ORDER.indexOf(idx), nxt=-1; for(var q=p+1;q<ORDER.length;q++){ if(!done[ORDER[q]]){ nxt=q; break; } }
          if(nxt===-1){ for(var q2=0;q2<ORDER.length;q2++){ if(!done[ORDER[q2]]){ nxt=q2; break; } } }
          if(nxt===-1 && ENG && !engDone) nxt=ORDER.length;
          active=nxt; update(true);
        }

        /* ---------- resumen, precio, barra ---------- */
        var shownPrice=null;
        function tween(el,to){ if(!el) return; var from=shownPrice===null?to:shownPrice, t0=null; function f(ts){ if(t0===null) t0=ts; var k=Math.min(1,(ts-t0)/350), e=1-Math.pow(1-k,3); el.textContent=money(from+(to-from)*e); if(k<1) requestAnimationFrame(f); } requestAnimationFrame(f); }
        function summary(v){
          var sum=$("ppx-sum"); if(!sum) return; var lines=[], tiles=[];
          var ci=-1; for(var i=0;i<N;i++){ if(kind(i)==="cfg") ci=i; }
          if(ci>-1 && /^M\d/.test(cur[ci]||"")){
            var c=cfgParse(cur[ci]); tiles=[["Chip",c.chip]]; if(c.cpu) tiles.push(["CPU",c.cpu+" núcleos"]); if(c.gpu) tiles.push(["GPU",c.gpu+" núcleos"]); if(c.mem) tiles.push(["Memoria unificada",c.mem]); if(c.ssd) tiles.push(["Almacenamiento SSD",c.ssd]);
          }
          for(var j=0;j<N;j++){ if(kind(j)!=="cfg"||tiles.length===0) lines.push(cur[j]); }
          var h='<p class="ppx-sum__t">Tu '+TITLE+'</p><p class="ppx-sum__l"></p>';
          if(tiles.length){ h+='<div class="ppx-tiles">'+tiles.map(function(t){ return '<div class="ppx-tile"><span class="ppx-tile__k"></span><span class="ppx-tile__v"></span></div>'; }).join("")+'</div>'; }
          sum.innerHTML=h; sum.querySelector(".ppx-sum__l").textContent=lines.join(" · ");
          [].forEach.call(sum.querySelectorAll(".ppx-tile"),function(el,i){ el.children[0].textContent=tiles[i][0]; el.children[1].textContent=tiles[i][1]; });
        }
        function pricing(v){
          var rows=$("ppx-rows"); if(!rows) return;
          var gmin=null; V.forEach(function(x){ if(gmin===null||x.price<gmin) gmin=x.price; });
          var si=-1, ci=-1; for(var i=0;i<N;i++){ if(kind(i)==="size") si=i; if(kind(i)==="cfg") ci=i; }
          var out=[]; out.push(["Desde ("+(function(){ for(var k=0;k<V.length;k++){ if(V[k].price===gmin) return V[k].o.filter(Boolean).slice(1).join(" · ")||V[k].o[0]; } return ""; })()+")",money(gmin)]);
          var sizeMin=gmin;
          if(si>-1){ var m=null; V.forEach(function(x){ if(x.o[si]===cur[si]&&(m===null||x.price<m)) m=x.price; }); sizeMin=m===null?gmin:m; if(sizeMin>gmin) out.push([NAMES[si]+": "+cur[si],"+ "+money(sizeMin-gmin)]); }
          if(v.price>sizeMin) out.push([(ci>-1?"Configuración elegida":"Mejoras elegidas"),"+ "+money(v.price-sizeMin)]);
          if(ENG && eng.on) out.push(["Grabado personalizado","Gratis · hasta 30 días hábiles"]);
          rows.innerHTML=out.map(function(r){ return '<div class="ppx-pricing__r"><span></span><span></span></div>'; }).join("");
          [].forEach.call(rows.children,function(el,i){ el.children[0].textContent=out[i][0]; el.children[1].textContent=out[i][1]; });
        }
        function update(animate,soft){
          var v=find(cur);
          if(!soft) renderSteps(); summary(v);
          updateImage(v);
          pricing(v);
          tween($("ppx-price"),v.price); tween($("ppx-bar-price"),v.price); shownPrice=v.price;
          var sel=$("ppx-bar-sel"); if(sel) sel.textContent=cur.filter(Boolean).join(" · ");
          var vid=$("ppx-vid"); if(vid) vid.value=v.id;
          var et=$("ppx-eng-t"), ep=$("ppx-eng-p"); if(et&&ep){ et.disabled=!(ENG&&eng.on); ep.disabled=!(ENG&&eng.on); et.value=eng.txt; }
          var nt=$("ppx-eng-note"); if(nt) nt.hidden=!(ENG&&eng.on);
          var cta=$("ppx-cta");
          if(cta && WA){ var digits=WA.replace(/[^0-9]/g,""); cta.href="https://wa.me/"+digits+"?text="+encodeURIComponent("Hola, me interesa el "+TITLE+" — "+cur.filter(Boolean).join(" / ")+"."); }
        }
        update(false);

        /* barra inferior fija: visible mientras el configurador esta en pantalla */
        var bar=$("ppx-bar"), root=document.getElementById("ppx-"+SID), btn=$("ppx-bar-btn");
        if(btn){ btn.onclick=function(){ var f=$("ppx-form"); if(f){ f.submit(); } else { var c=$("ppx-cta"); if(c) window.open(c.href,"_blank"); } }; }
        if(bar && root && "IntersectionObserver" in window){
          new IntersectionObserver(function(en){ bar.hidden=!en[0].isIntersecting; },{threshold:0.05}).observe(root);
        }
      })();
      </script>
    {%- endif -%}

    {%- comment -%} BLOQUES PERSONALIZADOS (imagen + descripción) {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="pp-features">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'feature' -%}
              <div class="pp-feature{% if block.settings.reverse %} pp-feature--reverse{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <div class="pp-feature__media">
                    {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(max-width: 749px) 100vw, 50vw', class: 'pp-feature__img', alt: block.settings.image.alt | default: block.settings.heading }}
                  </div>
                {%- endif -%}
                <div class="pp-feature__body">
                  {%- if block.settings.heading != blank -%}<h2 class="pp-feature__heading">{{ block.settings.heading }}</h2>{%- endif -%}
                  {%- if block.settings.text != blank -%}<div class="pp-feature__text rte">{{ block.settings.text }}</div>{%- endif -%}
                </div>
              </div>
            {%- when 'image_full' -%}
              <div class="pp-feature pp-feature--full" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '100vw', class: 'pp-feature__img-full', alt: block.settings.image.alt | default: '' }}
                {%- endif -%}
                {%- if block.settings.caption != blank -%}<p class="pp-feature__caption">{{ block.settings.caption }}</p>{%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
.ppx{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:48px;align-items:start;margin:32px 0 24px;}
.ppx>*{min-width:0;}
.ppx__media{position:sticky;top:96px;background:#f5f5f7;border-radius:28px;overflow:hidden;aspect-ratio:1/1;}
.ppx__track{display:flex;height:100%;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;outline:none;}
.ppx__track::-webkit-scrollbar{display:none;}
.ppx__slide{flex:0 0 100%;scroll-snap-align:center;display:flex;align-items:center;justify-content:center;padding:4px 4px 64px;box-sizing:border-box;}
.ppx__img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;user-select:none;}
.ppx__nav{position:absolute;left:0;right:0;bottom:22px;display:flex;align-items:center;justify-content:center;gap:14px;pointer-events:none;}
.ppx__nav[hidden]{display:none;}
.ppx__nav>*{pointer-events:auto;}
.ppx__arrow{width:40px;height:40px;border-radius:50%;border:none;background:rgba(210,210,215,.64);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);color:#1d1d1f;font-size:26px;line-height:1;cursor:pointer;padding:0 0 4px;}
.ppx__arrow:hover{background:rgba(190,190,195,.85);}
.ppx__dots{display:flex;align-items:center;gap:12px;background:rgba(210,210,215,.64);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);border-radius:999px;padding:14px 20px;}
.ppx__dot{width:8px;height:8px;border-radius:50%;border:none;background:rgba(0,0,0,.3);padding:0;cursor:pointer;transition:all .25s;}
.ppx__dot.is-sel{background:#1d1d1f;width:22px;border-radius:999px;}
.ppx__panel{max-width:540px;width:100%;}
.ppx-steps{list-style:none;margin:0 0 20px;padding:0;display:flex;gap:6px;flex-wrap:wrap;}
.ppx-steps li{font-size:12px;letter-spacing:.02em;color:#86868b;background:#ececf0;border-radius:999px;padding:6px 14px;cursor:pointer;transition:all .2s;}
.ppx-steps li.is-done{background:#e3f0fd;color:#0058b0;}
.ppx-steps li.is-active{background:#1d1d1f;color:#fff;}
.ppx-card{border:1px solid #e0e0e5;border-radius:20px;background:#fff;margin:0 0 12px;overflow:hidden;transition:box-shadow .2s,border-color .2s;}
.ppx-card.is-active{border-color:#c8c8cf;box-shadow:0 6px 24px rgba(0,0,0,.06);}
.ppx-card__h{display:flex;align-items:center;gap:14px;width:100%;text-align:left;padding:18px 20px;background:transparent;border:0;cursor:pointer;font:inherit;color:#1d1d1f;}
.ppx-card__n{flex:0 0 28px;height:28px;border-radius:50%;background:#1d1d1f;color:#fff;font-size:13px;font-weight:600;display:flex;align-items:center;justify-content:center;}
.ppx-card.is-done .ppx-card__n{background:#0071e3;}
.ppx-card__t{flex:1;font-size:18px;line-height:1.25;}
.ppx-card__t b{font-weight:600;}
.ppx-card__t i{font-style:normal;color:#86868b;}
.ppx-card.is-done .ppx-card__t i{display:none;}
.ppx-card__v{font-size:14px;color:#1d1d1f;font-weight:500;text-align:right;max-width:46%;}
.ppx-card__c{font-size:13px;color:#0071e3;}
.ppx-card__b{padding:0 20px 20px;animation:ppxin .28s ease;}
@keyframes ppxin{from{opacity:0;transform:translateY(-6px);}to{opacity:1;transform:none;}}
.ppx-colors{display:flex;flex-wrap:wrap;gap:12px;align-items:center;}
.ppx-sw{width:44px;height:44px;border-radius:50%;border:1px solid rgba(0,0,0,.14);cursor:pointer;padding:0;outline-offset:3px;transition:transform .15s;}
.ppx-sw:hover{transform:scale(1.06);}
.ppx-sw.is-sel{outline:2px solid #0071e3;}
.ppx-go{flex-basis:100%;margin:10px 0 0;align-self:flex-start;background:#0071e3;color:#fff;border:0;border-radius:980px;padding:11px 26px;font-size:15px;font-weight:500;cursor:pointer;transition:background .15s;}
.ppx-go:hover{background:#0077ed;}
.ppx-colors__n{flex-basis:100%;margin:6px 0 0;font-size:14px;color:#1d1d1f;font-weight:500;}
.ppx-list{display:flex;flex-direction:column;gap:10px;}
.ppx-size,.ppx-cfg{display:flex;justify-content:space-between;align-items:center;gap:16px;width:100%;text-align:left;padding:16px 18px;border:1px solid #d2d2d7;border-radius:16px;background:#fff;cursor:pointer;color:#1d1d1f;transition:border-color .15s,box-shadow .15s;}
.ppx-size:hover,.ppx-cfg:hover{border-color:#86868b;}
.ppx-size.is-sel,.ppx-cfg.is-sel{border-color:#0071e3;box-shadow:0 0 0 2px #0071e3;}
.ppx-size{display:grid;grid-template-columns:1fr auto;gap:2px 16px;}
.ppx-size__t{font-size:19px;font-weight:600;}
.ppx-size__s{font-size:13px;color:#6e6e73;grid-column:1;}
.ppx-size__p{font-size:14px;grid-column:2;grid-row:1/3;align-self:center;text-align:right;white-space:nowrap;}
.ppx-cfg__l{display:flex;flex-direction:column;gap:3px;min-width:0;}
.ppx-cfg__chip{font-size:17px;font-weight:600;}
.ppx-cfg__spec{font-size:13px;color:#6e6e73;}
.ppx-cfg__r{display:flex;flex-direction:column;align-items:flex-end;gap:2px;white-space:nowrap;}
.ppx-cfg__p{font-size:15px;font-weight:600;}
.ppx-cfg__d{font-size:12px;color:#6e6e73;}
.ppx-sum{margin:22px 0 8px;padding:22px;border-radius:20px;background:#f5f5f7;}
.ppx-sum__t{margin:0 0 4px;font-size:20px;font-weight:600;color:#1d1d1f;}
.ppx-sum__l{margin:0 0 16px;font-size:14px;color:#6e6e73;}
.ppx-tiles{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;}
.ppx-tile{background:#fff;border-radius:14px;padding:14px 16px;display:flex;flex-direction:column;gap:4px;}
.ppx-tile__k{font-size:12px;color:#86868b;letter-spacing:.02em;}
.ppx-tile__v{font-size:18px;font-weight:600;color:#1d1d1f;}
.ppx-hello{margin:0 0 18px;}
.ppx-hello__t{margin:0 0 6px;font-size:26px;font-weight:600;color:#1d1d1f;line-height:1.2;}
.ppx-hello__s{margin:0;font-size:15px;color:#6e6e73;}
.ppx-card__t small{font-size:15px;font-weight:500;color:#6e6e73;}
.ppx-cfg__who{font-size:12px;color:#0058b0;background:#e8f2fd;border-radius:999px;padding:5px 11px;text-align:center;white-space:normal;max-width:190px;}
.ppx-cfg{align-items:flex-start;}
.ppx-eng{margin-top:14px;padding:16px;border-radius:14px;background:#f5f5f7;}
.ppx-eng__l{display:block;font-size:13px;color:#6e6e73;margin:0 0 6px;}
.ppx-eng__i{width:100%;box-sizing:border-box;padding:12px 14px;border:1px solid #d2d2d7;border-radius:12px;font-size:16px;background:#fff;}
.ppx-eng__i:focus{outline:2px solid #0071e3;border-color:transparent;}
.ppx-eng__n{margin:12px 0;font-size:13.5px;line-height:1.45;color:#424245;}
.ppx-eng__ok{background:#1d1d1f;color:#fff;border:0;border-radius:980px;padding:10px 22px;font-size:14px;cursor:pointer;}
.ppx-eng__foot{margin:10px 2px 0;font-size:13px;color:#6e6e73;text-align:center;}
.ppx-pricing{margin:18px 0 16px;padding:22px;border-radius:20px;background:#fff;border:1px solid #e0e0e5;}
.ppx-pricing__h{margin:0 0 12px;font-size:18px;font-weight:600;color:#1d1d1f;}
.ppx-pricing__r{display:flex;justify-content:space-between;gap:16px;padding:9px 0;border-bottom:1px solid #f0f0f3;font-size:14.5px;color:#424245;}
.ppx-pricing__r span:last-child{font-variant-numeric:tabular-nums;white-space:nowrap;}
.ppx-pricing__tot{display:flex;justify-content:space-between;align-items:baseline;margin-top:14px;font-size:16px;font-weight:600;color:#1d1d1f;}
.ppx-pricing__tot .ppx__price{font-size:30px;}
.ppx__pricebox{margin:20px 0 14px;}
.ppx__price-label{font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:#6e6e73;margin:0 0 2px;}
.ppx__price{font-size:36px;font-weight:600;color:#1d1d1f;margin:0;font-variant-numeric:tabular-nums;}
.ppx__cta{display:inline-block;width:100%;box-sizing:border-box;text-align:center;background:#0071e3;color:#fff;border:none;border-radius:980px;padding:15px 22px;font-size:16px;font-weight:500;cursor:pointer;text-decoration:none;transition:background .15s;}
.ppx__cta:hover{background:#0077ed;}
.ppx-bar{position:fixed;left:0;right:0;bottom:0;z-index:50;background:rgba(255,255,255,.82);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);border-top:1px solid rgba(0,0,0,.08);padding:12px 20px calc(12px + env(safe-area-inset-bottom,0px));}
.ppx-bar[hidden]{display:none;}
.ppx-bar__in{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:20px;}
.ppx-bar__t{display:flex;flex-direction:column;min-width:0;font-size:15px;color:#1d1d1f;}
.ppx-bar__t span{font-size:12px;color:#6e6e73;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.ppx-bar__r{display:flex;align-items:center;gap:16px;}
.ppx-bar__p{font-size:20px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;}
.ppx-bar__b{background:#0071e3;color:#fff;border:none;border-radius:980px;padding:12px 22px;font-size:15px;font-weight:500;cursor:pointer;white-space:nowrap;}
.ppx-bar__b:hover{background:#0077ed;}
@media (max-width:749px){.ppx{grid-template-columns:1fr;gap:20px;}.ppx__media{position:relative;top:0;}.ppx__panel{max-width:none;}.ppx-bar__t span{display:none;}}
</style>

{% schema %}
{
  "name": "Producto principal",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "default": true, "label": "Mostrar marca" },
    { "type": "text", "id": "variants_title", "label": "Título de la sección de versiones", "default": "Nuestras versiones" },
    { "type": "text", "id": "price_label", "label": "Etiqueta de precio", "default": "Precio desde" },
    { "type": "text", "id": "storage_options", "label": "Opciones de almacenamiento (no usado en el configurador)", "info": "Separar con |." },
    { "type": "text", "id": "cta_label", "label": "Texto del botón" },
    { "type": "text", "id": "whatsapp_number", "label": "Número de WhatsApp (opcional)", "info": "Si lo llenas, el botón abre WhatsApp con el modelo elegido. Ej: 51987654321. Vacío = Agregar al carrito." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Imagen + descripción",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "heading", "label": "Título" },
        { "type": "richtext", "id": "text", "label": "Descripción" },
        { "type": "checkbox", "id": "reverse", "label": "Invertir orden (texto a la izquierda)", "default": false }
      ]
    },
    {
      "type": "image_full",
      "name": "Imagen completa",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "caption", "label": "Pie de imagen (opcional)" }
      ]
    }
  ],
  "presets": [ { "name": "Producto principal" } ]
}
{% endschema %}