{%- assign col = collections[section.settings.collection] -%}
{%- if col != blank and col.products_count > 0 -%}
<section class="pa-section">
  <div class="page-width">
    <h2 class="pa-title">{{ section.settings.heading | default: 'Completa tu equipo' }}</h2>
    {%- if section.settings.subtitle != blank -%}<p class="pa-sub">{{ section.settings.subtitle }}</p>{%- endif -%}
    <div class="pa-grid">
      {%- for p in col.products limit: 8 -%}
        <a class="pa-card" href="{{ p.url }}">
          <span class="pa-card__img">
            {%- if p.featured_image != blank -%}
              <img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.title | escape }}" loading="lazy" width="600" height="600">
            {%- endif -%}
          </span>
          <span class="pa-card__t">{{ p.title }}</span>
          <span class="pa-card__p">{%- if p.price > 0 -%}{{ p.price | money }}{%- else -%}Consultar precio{%- endif -%}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
.pa-section{padding:56px 0 24px;}
.pa-title{font-size:clamp(26px,3.2vw,36px);font-weight:600;color:#1d1d1f;margin:0 0 6px;letter-spacing:-.01em;}
.pa-sub{margin:0 0 24px;color:#6e6e73;font-size:16px;}
.pa-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;margin-top:22px;}
.pa-card{display:flex;flex-direction:column;gap:6px;padding:14px 14px 18px;background:#fff;border:1px solid #e6e6ea;border-radius:20px;text-decoration:none;color:#1d1d1f;transition:transform .2s,box-shadow .2s;}
.pa-card:hover{transform:translateY(-3px);box-shadow:0 10px 28px rgba(0,0,0,.08);}
.pa-card__img{display:flex;align-items:center;justify-content:center;aspect-ratio:1/1;background:#f5f5f7;border-radius:14px;overflow:hidden;margin-bottom:8px;}
.pa-card__img img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;}
.pa-card__t{font-size:15px;font-weight:600;line-height:1.3;}
.pa-card__p{font-size:14px;color:#6e6e73;}
@media (max-width:749px){.pa-grid{grid-auto-flow:column;grid-auto-columns:62%;grid-template-columns:none;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:6px;}.pa-card{scroll-snap-align:start;}}
</style>
{%- endif -%}
{% schema %}
{
  "name": "Accesorios del producto",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Completa tu equipo" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo (opcional)" },
    { "type": "collection", "id": "collection", "label": "Colección de accesorios" }
  ],
  "presets": [ { "name": "Accesorios del producto" } ]
}
{% endschema %}
