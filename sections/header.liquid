{% comment %} Header estilo Apple – nav translucido oscuro {% endcomment %}
<header class="hd" id="shopify-section-header" data-sticky="{{ section.settings.sticky_header_type }}">
  <div class="hd__inner page-width">
    {%- comment -%} Logo / Home icon {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="hd__logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
          alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
          width="{{ section.settings.logo_width }}"
          height="auto"
          loading="eager"
          class="hd__logo-img"
        >
      {%- else -%}
        <svg class="hd__apple-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17 48" width="14" height="44" aria-hidden="true"><path d="M15.5 24.076c-.028-3.17 2.584-4.692 2.7-4.763a5.877 5.877 0 0 0-4.632-2.504c-1.97-.2-3.848 1.16-4.85 1.16-1 0-2.546-1.13-4.184-1.1a6.158 6.158 0 0 0-5.183 3.161c-2.21 3.834-.566 9.515 1.588 12.627 1.053 1.524 2.31 3.235 3.96 3.174 1.588-.064 2.188-1.028 4.107-1.028 1.92 0 2.456 1.028 4.132.996 1.71-.028 2.8-1.553 3.838-3.083a12.696 12.696 0 0 0 1.74-3.567 5.573 5.573 0 0 1-3.216-5.073z" fill="currentColor"/></svg>
      {%- endif -%}
    </a>

    {%- comment -%} Nav principal {%- endcomment -%}
    <nav class="hd__nav" role="navigation" aria-label="Principal">
      <ul class="hd__nav-list" role="list">
        {%- for link in linklists[section.settings.menu].links -%}
          <li class="hd__nav-item"><a href="{{ link.url }}" class="hd__nav-link{% if link.active %} hd__nav-link--active{% endif %}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
        {%- endfor -%}
        {%- assign acc = collections['accesorios'] -%}
        {%- if acc != blank -%}
        <li class="hd__nav-item hd__nav-item--drop">
          <a href="{{ acc.url }}" class="hd__nav-link{% if request.path contains '/collections/accesorios' or request.path contains '/collections/correas' %} hd__nav-link--active{% endif %}" aria-haspopup="true">Accesorios</a>
          <ul class="hd__sub" role="list">
            <li><a href="{{ acc.url }}">Todos los accesorios</a></li>
            {%- if collections['accesorios-para-mac'].products_count > 0 -%}<li><a href="{{ collections['accesorios-para-mac'].url }}">Para Mac</a></li>{%- endif -%}
            {%- if collections['accesorios-para-ipad'].products_count > 0 -%}<li><a href="{{ collections['accesorios-para-ipad'].url }}">Para iPad</a></li>{%- endif -%}
            {%- if collections['correas-apple-watch'].products_count > 0 -%}<li><a href="{{ collections['correas-apple-watch'].url }}">Correas Apple Watch</a></li>{%- endif -%}
          </ul>
        </li>
        {%- endif -%}
      </ul>
    </nav>

    {%- comment -%} Iconos derecha {%- endcomment -%}
    <div class="hd__actions">
      {%- comment -%} Lupa de búsqueda {%- endcomment -%}
      <button class="hd__search-btn" aria-label="Buscar productos" aria-expanded="false" aria-controls="hd-search">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><line x1="16.5" y1="16.5" x2="21" y2="21"></line></svg>
      </button>

      {%- comment -%} Hamburguesa mobile {%- endcomment -%}
      <button class="hd__burger" aria-label="Menú" aria-expanded="false" aria-controls="hd-mobile-nav">
        <span class="hd__burger-line"></span>
        <span class="hd__burger-line"></span>
      </button>
    </div>
  </div>

  {%- comment -%} Barra de búsqueda desplegable {%- endcomment -%}
  <div class="hd__search" id="hd-search" aria-hidden="true">
    <form class="hd__search-form page-width" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      <svg class="hd__search-form-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="16.5" y1="16.5" x2="21" y2="21"></line></svg>
      <input type="search" name="q" class="hd__search-input" placeholder="Buscar en toda la tienda" autocomplete="off" enterkeyhint="search">
      <button type="button" class="hd__search-close" aria-label="Cerrar búsqueda">&times;</button>
    </form>
  </div>

  {%- comment -%} Mobile nav panel {%- endcomment -%}
  <div class="hd__mobile" id="hd-mobile-nav" aria-hidden="true">
    <nav class="hd__mobile-inner page-width">
      <ul class="hd__mobile-list" role="list">
        {%- for link in linklists[section.settings.menu].links -%}
          <li class="hd__mobile-item">
            <a href="{{ link.url }}" class="hd__mobile-link{% if link.active %} hd__mobile-link--active{% endif %}">
              {{ link.title | escape }}
            </a>
          </li>
        {%- endfor -%}
        {%- if acc != blank -%}
        <li class="hd__mobile-item"><a href="{{ acc.url }}" class="hd__mobile-link">Accesorios</a></li>
        {%- if collections['accesorios-para-mac'].products_count > 0 -%}<li class="hd__mobile-item hd__mobile-item--sub"><a href="{{ collections['accesorios-para-mac'].url }}" class="hd__mobile-link">Para Mac</a></li>{%- endif -%}
        {%- if collections['accesorios-para-ipad'].products_count > 0 -%}<li class="hd__mobile-item hd__mobile-item--sub"><a href="{{ collections['accesorios-para-ipad'].url }}" class="hd__mobile-link">Para iPad</a></li>{%- endif -%}
        {%- if collections['correas-apple-watch'].products_count > 0 -%}<li class="hd__mobile-item hd__mobile-item--sub"><a href="{{ collections['correas-apple-watch'].url }}" class="hd__mobile-link">Correas Apple Watch</a></li>{%- endif -%}
        {%- endif -%}
      </ul>
    </nav>
  </div>
</header>

<style>
.hd__search-btn{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;background:none;border:none;color:#f5f5f7;cursor:pointer;padding:0;margin-right:2px;}
.hd__search-btn:hover{opacity:.7;}
.hd__search{overflow:hidden;max-height:0;transition:max-height .28s ease;background:#1d1d1f;color:#f5f5f7;}
.hd--search-open .hd__search{max-height:96px;}
.hd__search-form{display:flex;align-items:center;gap:12px;padding:14px 0;}
.hd__search-form-icon{flex:0 0 auto;opacity:.7;}
.hd__search-input{flex:1;min-width:0;background:transparent;border:none;border-bottom:1px solid rgba(128,128,128,.35);color:inherit;font-size:17px;padding:8px 0;outline:none;}
.hd__search-input::placeholder{color:inherit;opacity:.5;}
.hd__search-close{flex:0 0 auto;background:none;border:none;color:inherit;font-size:26px;line-height:1;cursor:pointer;padding:0 4px;}
.hd__search-close:hover{opacity:.7;}
.hd__nav-item--drop{position:relative;}
.hd__sub{position:absolute;top:100%;left:50%;transform:translateX(-50%);min-width:210px;margin:0;padding:10px 0;list-style:none;background:rgba(22,22,23,.97);border-radius:14px;box-shadow:0 12px 32px rgba(0,0,0,.35);opacity:0;visibility:hidden;transition:opacity .15s;z-index:60;}
.hd__nav-item--drop:hover .hd__sub,.hd__nav-item--drop:focus-within .hd__sub{opacity:1;visibility:visible;}
.hd__sub a{display:block;padding:9px 20px;color:#e8e8ed;text-decoration:none;font-size:14px;white-space:nowrap;}
.hd__sub a:hover{color:#fff;background:rgba(255,255,255,.08);}
.hd__mobile-item--sub .hd__mobile-link{padding-left:28px;font-size:.92em;opacity:.85;}
</style>

<script>
(function(){
  var hdr = document.querySelector('.hd');
  var burger = hdr.querySelector('.hd__burger');
  var panel = hdr.querySelector('.hd__mobile');
  burger.addEventListener('click', function(){
    var open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    panel.setAttribute('aria-hidden', String(open));
    burger.classList.toggle('hd__burger--open');
    hdr.classList.toggle('hd--mobile-open');
  });

  /* Búsqueda desplegable */
  var searchBtn = hdr.querySelector('.hd__search-btn');
  var searchPanel = hdr.querySelector('.hd__search');
  var searchInput = hdr.querySelector('.hd__search-input');
  var searchClose = hdr.querySelector('.hd__search-close');
  function toggleSearch(force){
    var open = hdr.classList.contains('hd--search-open');
    var next = (force === undefined) ? !open : force;
    hdr.classList.toggle('hd--search-open', next);
    if (searchBtn) searchBtn.setAttribute('aria-expanded', String(next));
    if (searchPanel) searchPanel.setAttribute('aria-hidden', String(!next));
    if (next && searchInput) setTimeout(function(){ searchInput.focus(); }, 120);
  }
  if (searchBtn) searchBtn.addEventListener('click', function(){ toggleSearch(); });
  if (searchClose) searchClose.addEventListener('click', function(){ toggleSearch(false); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') toggleSearch(false); });

  /* Sticky on scroll up */
  var sticky = hdr.dataset.sticky;
  if (sticky === 'none') return;
  var lastY = 0;
  window.addEventListener('scroll', function(){
    var y = window.pageYOffset;
    if (sticky === 'always') {
      hdr.classList.add('hd--stuck');
    } else {
      if (y < lastY && y > 44) {
        hdr.classList.add('hd--stuck');
      } else {
        hdr.classList.remove('hd--stuck');
      }
    }
    lastY = y;
  }, {passive: true});
})();
</script>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Ancho del logo",
      "default": 100
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "sticky_header_type",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "on-scroll-up", "label": "Al desplazar hacia arriba" },
        { "value": "always", "label": "Siempre" }
      ],
      "default": "on-scroll-up",
      "label": "Encabezado fijo"
    }
  ]
}
{% endschema %}
